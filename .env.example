# Referencia: exportar estas variables en la terminal antes de ejecutar Django.
# La carga automatica de archivos .env aun no esta implementada.
DJANGO_SECRET_KEY=replace-with-a-local-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=reviewiq_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
